# Shogun OS Registry environment template
# Copy to .env and fill in secrets.
#
# Product design:
# - Customers never need a Cloudflare account
# - Each tenant gets a random {adj}-{noun}-{nn}.shogun-os.ai URL
# - One company portal / one dashboard for all department agents

HOST=0.0.0.0
PORT=9000
LOG_LEVEL=info
# Apex domain you control in Cloudflare (our zone, not the customer's)
REGISTRY_DOMAIN=shogun-os.ai

# Admin / registration auth
ADMIN_API_KEY=change-me-admin-key
# Shared secret customer installers send on POST /api/register
REGISTRATION_TOKEN=change-me-registration-token

# SQLite path (container default)
DATABASE_PATH=/var/lib/shogun-registry/registry.db
# For local dev outside Docker:
# ALLOW_INSECURE_LOCAL_DB=true
# DATABASE_PATH=./data/registry.db

HEALTH_CHECK_INTERVAL_SECONDS=30
HEARTBEAT_STALE_SECONDS=120

# ── Cloudflare (OUR account — customers never configure this) ─────────────
# Create an API token with:
#   Account → Cloudflare Tunnel → Edit
#   Zone → DNS → Edit  (for REGISTRY_DOMAIN zone)
#   Zone → Zone → Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# When true + CF credentials set: auto-create per-tenant tunnel + CNAME on register
ENABLE_TUNNEL_PROVISIONING=true
# Always random subdomains for customers (recommended)
ALLOW_PREFERRED_SUBDOMAIN=false
# Auto-create tunnel unless client explicitly opts out
DEFAULT_CREATE_TUNNEL=true

# docker-compose port publish
REGISTRY_PORT=9000
